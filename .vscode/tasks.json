{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GOOUUU: Build",
      "type": "PlatformIO",
      "task": "Build",
      "problemMatcher": [
        "$platformio"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "GOOUUU: Build and upload C++",
      "type": "PlatformIO",
      "task": "Upload",
      "problemMatcher": [
        "$platformio"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "GOOUUU: Upload",
      "dependsOn": [
        "GOOUUU: Build and upload C++"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "GOOUUU: Monitor",
      "type": "PlatformIO",
      "task": "Monitor",
      "problemMatcher": [
        "$platformio"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "GOOUUU: Open USB camera",
      "type": "process",
      "command": "xdg-open",
      "args": [
        "${workspaceFolder}/firmware/goouuu_esp32_s3/data/viewer.html"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/tools/open_wired_viewer.ps1"
        ]
      },
      "osx": {
        "command": "open"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
