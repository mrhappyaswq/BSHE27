{
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(play) Build + upload C++",
      "task": "GOOUUU: Build and upload C++"
    },
    {
      "label": "$(tools) Build only",
      "task": "GOOUUU: Build"
    },
    {
      "label": "$(terminal) Monitor",
      "task": "GOOUUU: Monitor"
    },
    {
      "label": "$(device-camera-video) USB camera",
      "task": "GOOUUU: Open USB camera"
    }
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".venv": true,
    ".pytest_cache": true,
    ".git": true,
    ".gitignore": true,
    ".vscode": true,
    "**/.pio": true
  },
  "search.exclude": {
    "Build Stuff/**": true,
    "Guides/**": true,
    "Build Tools/**": true,
    "Saved Results/**": true,
    ".venv/**": true,
    "**/__pycache__/**": true
  },
  "files.watcherExclude": {
    "**/Build Stuff/**": true,
    "**/Build Tools/**": true,
    "**/Saved Results/**": true,
    "**/.pio/**": true
  },
  "git.autofetch": true,
  "platformio-ide.defaultProjectEnv": "goouuu_esp32_s3"
}
