{
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(play) Build + upload C++",
      "task": "GOOUUU: Build and upload C++"
    },
    {
      "label": "$(tools) Build only",
      "task": "GOOUUU: Build"
    },
    {
      "label": "$(terminal) Monitor",
      "task": "GOOUUU: Monitor"
    },
    {
      "label": "$(device-camera-video) USB camera",
      "task": "GOOUUU: Open USB camera"
    }
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}/device"
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".venv": true,
    ".pytest_cache": true,
    "**/.pio": true
  },
  "search.exclude": {
    "local/**": true,
    ".venv/**": true,
    "**/__pycache__/**": true,
    "**/.pio/**": true
  },
  "platformio-ide.defaultProjectEnv": "goouuu_esp32_s3"
}
